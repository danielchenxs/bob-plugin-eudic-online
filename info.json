{
  "identifier": "com.chenxs.bob.eudic.online",
  "version": "0.8.0",
  "category": "translate",
  "name": "欧路在线词典",
  "summary": "欧路英汉英英释义、美英发音、维基词源与可选生词本同步",
  "author": "chenxs",
  "homepage": "https://dict.eudic.net",
  "minBobVersion": "1.21.0",
  "options": [
    {
      "identifier": "pronunciation",
      "type": "menu",
      "title": "音标与发音",
      "defaultValue": "both",
      "menuValues": [
        {
          "title": "美音和英音",
          "value": "both"
        },
        {
          "title": "仅美音",
          "value": "us"
        },
        {
          "title": "仅英音",
          "value": "uk"
        },
        {
          "title": "隐藏",
          "value": "none"
        }
      ],
      "desc": "控制 Bob 原生音标及本词发音按钮。"
    },
    {
      "identifier": "showEnglish",
      "type": "menu",
      "title": "英英释义",
      "defaultValue": "on",
      "menuValues": [
        {
          "title": "显示",
          "value": "on"
        },
        {
          "title": "隐藏",
          "value": "off"
        }
      ]
    },
    {
      "identifier": "showEtymology",
      "type": "menu",
      "title": "词根词缀",
      "defaultValue": "on",
      "menuValues": [
        {
          "title": "显示",
          "value": "on"
        },
        {
          "title": "隐藏",
          "value": "off"
        }
      ]
    },
    {
      "identifier": "showForms",
      "type": "menu",
      "title": "原形与词形",
      "defaultValue": "on",
      "menuValues": [
        {
          "title": "显示",
          "value": "on"
        },
        {
          "title": "隐藏",
          "value": "off"
        }
      ],
      "desc": "包括时态、其他词形、原形和基词建议。"
    },
    {
      "identifier": "showPhrases",
      "type": "menu",
      "title": "词组",
      "defaultValue": "on",
      "menuValues": [
        {
          "title": "显示",
          "value": "on"
        },
        {
          "title": "隐藏",
          "value": "off"
        }
      ]
    },
    {
      "identifier": "exampleCount",
      "type": "menu",
      "title": "听力例句",
      "defaultValue": "4",
      "menuValues": [
        {
          "title": "关闭",
          "value": "0"
        },
        {
          "title": "1 条",
          "value": "1"
        },
        {
          "title": "2 条",
          "value": "2"
        },
        {
          "title": "4 条",
          "value": "4"
        }
      ],
      "desc": "关闭时隐藏例句与原声、更多例句链接。"
    },
    {
      "identifier": "autoAdd",
      "type": "menu",
      "title": "自动加入欧路生词本",
      "defaultValue": "off",
      "menuValues": [
        {
          "title": "关闭",
          "value": "off"
        },
        {
          "title": "开启",
          "value": "on"
        }
      ],
      "desc": "查词成功后自动加入当前查询词，默认关闭。"
    },
    {
      "identifier": "eudicAuthorization",
      "type": "text",
      "title": "欧路 API 授权信息",
      "textConfig": {
        "type": "secure",
        "placeholderText": "填写欧路完整 API 授权信息"
      },
      "defaultValue": "",
      "desc": "填写完整 Authorization 值，不要额外加 Bearer。"
    },
    {
      "identifier": "wordbookId",
      "type": "text",
      "title": "生词本 ID",
      "defaultValue": "0",
      "desc": "默认 0；开启自动加入后可点击验证检查授权和分组。",
      "textConfig": {
        "type": "visible"
      }
    }
